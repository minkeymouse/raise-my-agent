# ─────────────────────────────────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 본인의 키를 입력하세요.
#   cp .env.example .env
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# [필수] 거의 모든 장 (1~10장)
OPENAI_API_KEY="sk-..."

# [9장 필수, 1장 선택] Claude 모델 - https://platform.claude.com/
#   9장 MCP 실습의 에이전트가 anthropic:claude-sonnet-4-6 모델을 사용합니다.
ANTHROPIC_API_KEY=""

# [4장, 10장] 네이버 검색 도구 - https://developers.naver.com/
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# [선택] LangSmith 추적 / LangGraph Studio - https://smith.langchain.com/
LANGSMITH_API_KEY=""
LANGSMITH_TRACING="false"
LANGSMITH_PROJECT="raise-my-agent"

# [8장] Neo4j 지식베이스
#   책의 방법(Neo4j Desktop 로컬 인스턴스): bolt://localhost:7687 - https://neo4j.com/download/
#   Neo4j Aura를 쓴다면 자격 증명 파일의 neo4j+s://xxxxxxxx.databases.neo4j.io 주소로 바꿉니다.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"
# [8장 선택] 시험공부 에이전트(chapter8 패키지)가 쓰는 채팅 모델 (기본값: gpt-4o-mini)
# CHAPTER8_LLM_MODEL="gpt-4o-mini"
