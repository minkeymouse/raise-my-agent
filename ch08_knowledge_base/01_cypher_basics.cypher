// =====================================================================
// [8장 1절] [neo4j] 지식 베이스 이해하기 - 3. 그래프 데이터베이스란?
//
// 이 절에서 배우는 것:
// - 그래프 데이터베이스는 노드(Node, 사람·장소·사물 같은 엔티티)와 관계(Relationship, 노드 사이의 연결)로 데이터를 저장합니다.
// - Cypher는 노드와 관계를 화살표로 적어 패턴을 찾는(패턴 매칭) Neo4j의 질의 언어입니다.
// - CREATE로 노드와 관계를 만들고, MATCH로 패턴에 맞는 부분 그래프를 찾아 RETURN으로 돌려받습니다.
//
// 실행 방법:
//     파이썬 파일이 아니라 Neo4j Browser(Neo4j Desktop 또는 Aura 콘솔의 Query 화면)에서 실행하는 질의문입니다.
//     "// ----" 줄로 구분된 덩어리를 하나씩 복사해 붙여 넣고 실행합니다.
// 준비물: Neo4j 인스턴스 (설치와 접속 정보는 01_store_basics.py 머리말의 '8장 준비물' 참고)
// 표시: [보충] 실행에 필요한 코드, [수정] 실행에 맞게 고친 코드, [설명용 코드] 실행되지 않는 설명용 조각
// =====================================================================


// ---------------------------------------------------------------------
// 관계형 데이터베이스 vs 그래프 데이터베이스
// ---------------------------------------------------------------------
// "김철수는 치와와를 좋아한다"를 관계형 DB(MySQL, PostgreSQL 등)에 저장하면 테이블 세 개가 필요하고,
// 조회할 때 외래키로 JOIN해야 합니다. 관계가 많아질수록 조인이 늘어 쿼리가 복잡해집니다.

/* [설명용 코드] 비교를 위한 관계형 데이터베이스 방식(SQL)입니다. Neo4j에서 실행하는 코드가 아닙니다.

-- 사람 테이블
CREATE TABLE people (id INT, name VARCHAR);
-- 강아지 테이블
CREATE TABLE dogs (id INT, name VARCHAR);
-- 좋아함 관계 테이블
CREATE TABLE likes (person_id INT, dog_id INT);

-- 조회하려면 조인 필요
SELECT p.name, d.name
FROM people p
JOIN likes l ON p.id = l.person_id
JOIN dogs d ON l.dog_id = d.id;
*/

// ---------------------------------------------------------------------
// 그래프 데이터베이스 방식
// ---------------------------------------------------------------------
// 같은 정보를 노드 두 개와 LIKES 관계 하나로 저장합니다. 관계(엣지)를 따라가는 조회를 쿼리 자체로 적을 수 있습니다.
// 참고: "WITH is required between CREATE and MATCH" 오류가 나면 '// 조회' 아래 두 줄을 따로 실행합니다.
// 노드 생성
CREATE (p:Person {name: "김철수"})
CREATE (d:Dog {name: "치와와"})
// 관계 생성
CREATE (p)-[:LIKES]->(d)

// 조회 - 훨씬 직관적!
MATCH (p:Person)-[:LIKES]->(d:Dog)
RETURN p.name, d.name


// ---------------------------------------------------------------------
// Cypher Query 이해하기 - 노드 만들기
// ---------------------------------------------------------------------
// ()는 노드, :Person은 노드의 레이블(타입), {name: "김철수"}는 노드의 속성(properties)입니다.
// 단일 노드 생성
CREATE (p:Person {name: "김철수", age: 30})

// 여러 노드 생성
CREATE (p1:Person {name: "김철수"})
CREATE (p2:Person {name: "이영희"})
CREATE (d:Dog {name: "치와와", breed: "치와와"})


// ---------------------------------------------------------------------
// Cypher Query 이해하기 - 관계 만들기 (둘 중 하나만 실행)
// ---------------------------------------------------------------------
// MATCH는 SQL의 SELECT처럼 패턴에 맞는 부분 그래프를 찾는 출발점입니다. 찾은 두 노드 사이에 CREATE로 관계를 만듭니다.
// -[:LIKES]->는 방향이 있는 관계, [:LIKES]는 관계의 타입, {since: "2024-01-01"}은 관계의 속성입니다.
// 기존 노드 간 관계 생성
MATCH (p:Person {name: "김철수"})
MATCH (d:Dog {name: "치와와"})
CREATE (p)-[:LIKES]->(d)

// ----
// 또는 한 번에 생성
MATCH (p:Person {name: "김철수"}), (d:Dog {name: "치와와"})
CREATE (p)-[:LIKES {since: "2024-01-01"}]->(d)


// ---------------------------------------------------------------------
// Cypher Query 이해하기 - MATCH로 조회하기 (하나씩 실행)
// ---------------------------------------------------------------------
// 순서대로 "모든 사람", "이름이 김철수인 사람", "강아지를 좋아하는 사람"을 찾습니다.
// 그래프 데이터베이스는 이처럼 관계를 기반으로 한 검색에 강합니다.
// 모든 Person 노드 조회
MATCH (p:Person)
RETURN p

// ----
// 특정 조건으로 조회
MATCH (p:Person {name: "김철수"})
RETURN p.name, p.age

// ----
// 관계를 따라 탐색
MATCH (p:Person)-[:LIKES]->(d:Dog)
RETURN p.name, d.name
